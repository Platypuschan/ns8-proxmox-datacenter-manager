#!/bin/bash

# SPDX-License-Identifier: GPL-3.0-or-later

# Print the reference of the Proxmox Datacenter Manager application image built
# from app/.
#
# The tag is the Git tree hash of app/, so it changes with every change in that
# directory (for example a new PDM_VERSION) and never otherwise. A published
# module image therefore always points to the image it was tested with, and a
# tag is never reused for different content.

set -Eeuo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
repobase="${REPOBASE:-ghcr.io/platypuschan}"

if [[ -n "$(git -C "${root}" status --porcelain -- app)" ]]; then
    echo "app/ has uncommitted changes; commit them first so the tag matches the content." >&2
    exit 1
fi

tree="$(git -C "${root}" rev-parse --short=12 HEAD:app)"
printf '%s/pdm-app:%s\n' "${repobase,,}" "${tree}"
