#!/usr/bin/env python3

# SPDX-License-Identifier: GPL-3.0-or-later

"""Find the newest Proxmox Datacenter Manager release and prepare the bump.

  update-pdm --latest          print the newest version in the Proxmox repository
  update-pdm --base-latest     print the current digest of debian:trixie-slim
  update-pdm --apply VERSION   set PDM_VERSION in app/Containerfile and raise
                               CATALOG_VERSION so that CI publishes a new module
  update-pdm --update          apply a newer PDM version and/or base image digest
                               with one CATALOG_VERSION bump; print a summary,
                               or nothing if everything is current
  update-pdm --update --runtime-image IMAGE
                               also check the immutable published runtime for
                               independent dependency upgrades; remember new
                               targets in app/package-refresh.json (a cumulative
                               rebuild request, not an apt version lockfile)

The repository index is only used to propose a change. The image build installs
the package through apt, which verifies the signed repository metadata.
"""

import argparse
import gzip
import json
import re
import sys
import subprocess
import urllib.parse
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
CONTAINERFILE = ROOT / "app/Containerfile"
VERSION_FILE = ROOT / "CATALOG_VERSION"
INDEX_URL = (
    "http://download.proxmox.com/debian/pdm/dists/trixie/"
    "pdm-no-subscription/binary-amd64/Packages.gz"
)
PDM_VERSION_RE = re.compile(r"^(ARG PDM_VERSION=)(\S+)$", re.MULTILINE)
BASE_RE = re.compile(r"^(ARG BASE_IMAGE=docker\.io/library/debian:trixie-slim@)(sha256:[0-9a-f]{64})$", re.MULTILINE)
BASE_REPOSITORY = "library/debian"
BASE_TAG = "trixie-slim"
HELD_PDM_PACKAGES = (
    "proxmox-datacenter-manager",
    "proxmox-datacenter-manager-ui",
    "proxmox-datacenter-manager-docs",
    "proxmox-datacenter-manager-client",
    "proxmox-datacenter-manager-meta",
)


def version_key(text):
    """Order dotted Proxmox versions such as 1.1.9; reject anything else."""
    if not re.fullmatch(r"[0-9]+(\.[0-9]+)*", text):
        raise ValueError(f"unsupported version: {text!r}")
    return tuple(int(part) for part in text.split("."))


def newest_version(index_text):
    """Return the highest version of the proxmox-datacenter-manager package."""
    versions = []
    for stanza in index_text.split("\n\n"):
        fields = dict(
            line.split(": ", 1) for line in stanza.splitlines() if ": " in line and not line.startswith(" ")
        )
        if fields.get("Package") == "proxmox-datacenter-manager":
            try:
                version_key(fields["Version"])
            except (KeyError, ValueError):
                continue
            versions.append(fields["Version"])
    if not versions:
        raise ValueError("proxmox-datacenter-manager not found in the package index")
    return max(versions, key=version_key)


def current_version(containerfile_text):
    match = PDM_VERSION_RE.search(containerfile_text)
    if not match:
        raise ValueError("ARG PDM_VERSION not found in app/Containerfile")
    return match.group(2)


def bump_catalog_version(text):
    """0.1.0-rc.1 -> 0.1.0-rc.2, 0.1.0 -> 0.1.1, 0.1.0-beta -> 0.1.0-beta.1"""
    text = text.strip()
    match = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?", text)
    if not match:
        raise ValueError(f"invalid SemVer version: {text!r}")
    major, minor, patch, pre = match.groups()
    if pre is None:
        return f"{major}.{minor}.{int(patch) + 1}"
    parts = pre.split(".")
    if parts[-1].isdigit():
        parts[-1] = str(int(parts[-1]) + 1)
    else:
        parts.append("1")
    return f"{major}.{minor}.{patch}-{'.'.join(parts)}"


def current_base(containerfile_text):
    match = BASE_RE.search(containerfile_text)
    if not match:
        raise ValueError("ARG BASE_IMAGE with a sha256 digest not found in app/Containerfile")
    return match.group(2)


def rewrite(containerfile, version_file, version=None, base=None, *, packages=None, refresh_file=None):
    """Apply PDM/base/runtime targets together with one catalog version bump."""
    text = containerfile.read_text(encoding="utf-8")
    changes = []
    if version is not None:
        version_key(version)
        if current_version(text) != version:
            text = PDM_VERSION_RE.sub(rf"\g<1>{version}", text, count=1)
            changes.append(f"PDM {version}")
    if base is not None:
        if not re.fullmatch(r"sha256:[0-9a-f]{64}", base):
            raise ValueError(f"invalid digest: {base!r}")
        if current_base(text) != base:
            text = BASE_RE.sub(rf"\g<1>{base}", text, count=1)
            changes.append(f"base image {base[:19]}")
    refreshed = None
    if packages:
        refresh_file = refresh_file or containerfile.parent / "package-refresh.json"
        cumulative = json.loads(refresh_file.read_text(encoding="utf-8"))["packages"]
        new_targets = {}
        for package, target in packages.items():
            previous = cumulative.get(package)
            if previous is None:
                new_targets[package] = target
            elif target != previous:
                result = subprocess.run(["dpkg", "--compare-versions", target, "gt", previous], check=False)
                if result.returncode not in (0, 1):
                    raise ValueError("invalid package version in runtime refresh")
                if result.returncode == 0:
                    new_targets[package] = target
        if new_targets:
            cumulative.update(new_targets)
            refreshed = json.dumps({"packages": cumulative}, indent=2, sort_keys=True) + "\n"
            count = len(new_targets)
            changes.append(f"runtime packages ({count} new target{'s' if count != 1 else ''})")
    if changes:
        next_version = bump_catalog_version(version_file.read_text(encoding="utf-8")) + "\n"
        if text != containerfile.read_text(encoding="utf-8"):
            containerfile.write_text(text, encoding="utf-8")
        if refreshed is not None:
            refresh_file.write_text(refreshed, encoding="utf-8")
        version_file.write_text(next_version, encoding="utf-8")
    return changes


def apply(version, containerfile=CONTAINERFILE, version_file=VERSION_FILE):
    return bool(rewrite(containerfile, version_file, version=version))


def fetch_base_digest():
    """Digest of the multi-arch index behind debian:trixie-slim (Docker Hub)."""
    scope = urllib.parse.quote(f"repository:{BASE_REPOSITORY}:pull")
    with urllib.request.urlopen(
        f"https://auth.docker.io/token?service=registry.docker.io&scope={scope}", timeout=30
    ) as response:
        token = json.load(response)["token"]
    request = urllib.request.Request(
        f"https://registry-1.docker.io/v2/{BASE_REPOSITORY}/manifests/{BASE_TAG}",
        method="HEAD",
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.oci.image.index.v1+json, "
            "application/vnd.docker.distribution.manifest.list.v2+json",
        },
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        digest = response.headers["Docker-Content-Digest"]
    if not re.fullmatch(r"sha256:[0-9a-f]{64}", digest or ""):
        raise ValueError(f"unexpected digest from the registry: {digest!r}")
    return digest


def fetch_index():
    with urllib.request.urlopen(INDEX_URL, timeout=60) as response:
        return gzip.decompress(response.read()).decode("utf-8")


def parse_upgrade_targets(output):
    """Extract target versions from LC_ALL=C apt-get simulation output."""
    targets = {}
    for line in output.splitlines():
        if not line.startswith("Inst "):
            continue
        match = re.fullmatch(r"Inst ([a-z0-9][a-z0-9+.:\-]*) (?:\[[^\]]+\] )?\((\S+) .+\)", line)
        if not match:
            raise ValueError(f"unrecognized apt upgrade line: {line!r}")
        if match.group(1).split(":", 1)[0] in HELD_PDM_PACKAGES:
            raise ValueError("runtime refresh would change a held PDM package")
        targets[match.group(1)] = match.group(2)
    return targets


def probe_runtime_packages(image):
    """Simulate upgrades in the actual runtime, never in the host environment.

    No entrypoint, host mounts, image volumes or elevated capabilities. Only
    apt-get update fetches repository metadata; the upgrade is a simulation.
    """
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._:/-]*@sha256:[0-9a-f]{64}", image):
        raise ValueError("--runtime-image must be an immutable image@sha256 reference")
    shell = (
        "apt-mark hold " + " ".join(HELD_PDM_PACKAGES) + "; "
        "apt-get update -o APT::Update::Error-Mode=any -o APT::Sandbox::User=root; "
        "apt-get -s --with-new-pkgs upgrade"
    )
    result = subprocess.run(
        ["podman", "run", "--rm", "--pull=always", "--user=0", "--cap-drop=all",
         "--security-opt=no-new-privileges", "--image-volume=ignore", "--timeout=540",
         "--network=bridge", "--env=LC_ALL=C", "--env=DEBIAN_FRONTEND=noninteractive",
         "--entrypoint=/bin/sh", image, "-ec", shell],
        check=True, capture_output=True, text=True, timeout=600,
    )
    return parse_upgrade_targets(result.stdout)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--latest", action="store_true")
    group.add_argument("--apply", metavar="VERSION")
    group.add_argument("--base-latest", action="store_true")
    group.add_argument("--update", action="store_true")
    parser.add_argument("--runtime-image", metavar="IMAGE", help="immutable published runtime to check (with --update only)")
    args = parser.parse_args()
    if args.runtime_image and not args.update:
        parser.error("--runtime-image requires --update")
    if args.latest:
        print(newest_version(fetch_index()))
        return 0
    if args.base_latest:
        print(fetch_base_digest())
        return 0
    if args.update:
        packages = probe_runtime_packages(args.runtime_image) if args.runtime_image else None
        changes = rewrite(CONTAINERFILE, VERSION_FILE, newest_version(fetch_index()), fetch_base_digest(), packages=packages)
        if changes:
            print(", ".join(changes))
        return 0
    print("changed" if apply(args.apply) else "unchanged")
    return 0


if __name__ == "__main__":
    sys.exit(main())
