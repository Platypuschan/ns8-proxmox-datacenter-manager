import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import agent
import pdm_options

event = json.load(sys.stdin)

def read_host():
    # The agent process may have started before the first configuration, so
    # its own environment can lack TRAEFIK_HOST; the state file is authoritative.
    try:
        with open("environment", encoding="utf-8") as stream:
            for line in stream:
                if line.startswith("TRAEFIK_HOST="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return os.environ.get("TRAEFIK_HOST", "")


host = read_host()
options = pdm_options.read_options() or pdm_options.normalize(None)
print("certificate-changed: host=%r tls_import=%r names=%r" % (host, options.get("tls_import"), event.get("names")), file=sys.stderr)

if not host or not options.get("tls_import") or not agent.certificate_event_matches(event, host):
    sys.exit(0)  # not relevant for this instance

proc = agent.run_helper("get-certificate", "--cert-file=tls-certs/cert.pem",
                        "--key-file=tls-certs/key.pem", host)
# 0 = new certificate, 3 = unchanged. The container reads it at start only.
if proc.returncode == 0:
    agent.run_helper("systemctl", "--user", "try-restart", "pdm.service")
