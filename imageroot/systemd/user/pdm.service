[Unit]
Description=Proxmox Datacenter Manager (Podman)

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
# The entrypoint needs time to stop its daemons cleanly.
TimeoutStartSec=120
TimeoutStopSec=140
ExecStartPre=/bin/rm -f %t/pdm.pid %t/pdm.ctr-id
# options.env: first-configuration choices; tls-certs: certificate of Traefik
ExecStartPre=/bin/sh -c 'touch %E/state/options.env; mkdir -p -m 0700 %E/state/tls-certs'
# Rootless: the container needs no extra privileges. --tmpfs provides the
# shared-memory directory of the API. admin.env holds PASSWORD_HASH.
ExecStart=/usr/bin/podman run --detach \
    --conmon-pidfile %t/pdm.pid --cidfile %t/pdm.ctr-id --cgroups=no-conmon \
    --replace --name pdm --hostname pdm \
    --publish 127.0.0.1:${TCP_PORT}:8443 \
    --tmpfs /run/proxmox-datacenter-manager/shmem \
    --volume pdm-config:/etc/proxmox-datacenter-manager:Z \
    --volume pdm-data:/var/lib/proxmox-datacenter-manager:Z \
    --volume pdm-log:/var/log/proxmox-datacenter-manager:Z \
    --volume %E/state/tls-certs:/run/ns8-tls:ro,Z \
    --env-file %E/state/admin.env \
    --env-file %E/state/options.env \
    --stop-timeout 120 \
    ${PDM_APP_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/pdm.ctr-id -t 120
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/pdm.ctr-id
SyslogIdentifier=%u
PIDFile=%t/pdm.pid
Type=forking

[Install]
WantedBy=default.target
