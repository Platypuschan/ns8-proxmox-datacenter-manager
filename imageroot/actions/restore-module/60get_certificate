import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import agent
import pdm_options

# Fetch the certificate Traefik serves for the host name, so the web interface
# of Proxmox Datacenter Manager (Certificates page) shows it. The container
# installs it at every start (PDM_TLS_IMPORT). Failure is not fatal: the
# container keeps its own certificate.
options = pdm_options.read_options() or {}
if options.get("tls_import"):
    os.makedirs("tls-certs", mode=0o700, exist_ok=True)
    proc = agent.run_helper("get-certificate", "--cert-file=tls-certs/cert.pem",
                            "--key-file=tls-certs/key.pem", os.environ["TRAEFIK_HOST"])
    if proc.returncode == 0:
        pass  # the service is started after the restore
    elif proc.returncode != 3:
        print("Could not obtain the Traefik certificate; PDM keeps its own.", file=sys.stderr)
