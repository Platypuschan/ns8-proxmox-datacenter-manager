import sys
import json
import agent
import agent.tasks
import os

request = json.load(sys.stdin)
renv = request['environment']

# A restore that replaces the source takes over its host name (the source is
# removed afterwards). A restore next to a running instance with the same host
# name must not register a second route for it.
host = renv["TRAEFIK_HOST"]
register_route = bool(request.get("replace")) or not agent.http_route_in_use(domain=host)

configure_retval = agent.tasks.run(agent_id=os.environ['AGENT_ID'], action='configure-module', data={
    "lets_encrypt": renv["TRAEFIK_LETS_ENCRYPT"] == "True",
    "host": host,
    "http2https": renv["TRAEFIK_HTTP2HTTPS"] == "True",
    "register_route": register_route,
})
agent.assert_exp(configure_retval['exit_code'] == 0, "The configure-module subtask failed!")
