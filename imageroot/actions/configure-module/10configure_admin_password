import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import pdm_config

data = json.load(sys.stdin)
password = data.get("admin_password") or ""

# An empty value keeps the current password. The hash is applied by the
# container at its next (re)start, see 80start_services.
if password:
    pdm_config.write_admin_password(password)
