import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import pdm_config

agent.set_weight(os.path.basename(__file__), 0) # Validation step, no task progress at all

data = json.load(sys.stdin)
password = data.get("admin_password") or ""

if password:
    try:
        pdm_config.validate_password(password)
    except pdm_config.PasswordError as exc:
        agent.set_status('validation-failed')
        json.dump([{'field': 'admin_password', 'parameter': 'admin_password', 'value': '', 'error': exc.args[0]}], fp=sys.stdout)
        sys.exit(2)
elif not pdm_config.has_admin_password():
    # The first start needs a password: there is no usable default login.
    agent.set_status('validation-failed')
    json.dump([{'field': 'admin_password', 'parameter': 'admin_password', 'value': '', 'error': 'admin_password_required'}], fp=sys.stdout)
    sys.exit(2)
