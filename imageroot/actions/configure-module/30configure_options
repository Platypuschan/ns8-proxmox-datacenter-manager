import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import pdm_options

data = json.load(sys.stdin)

# The options are chosen once, at the first configuration. Later requests
# keep the stored values (the web interface shows them as information only).
if not pdm_options.options_exist():
    pdm_options.write_options(data.get("options"))
