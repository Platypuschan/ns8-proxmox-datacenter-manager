import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import pdm_options

agent.set_weight(os.path.basename(__file__), 0) # Validation step, no task progress at all

data = json.load(sys.stdin)
try:
    pdm_options.normalize(data.get("options"))
except pdm_options.OptionsError as exc:
    agent.set_status('validation-failed')
    json.dump([{'field': 'options', 'parameter': 'options', 'value': '', 'error': exc.args[0]}], fp=sys.stdout)
    sys.exit(2)
