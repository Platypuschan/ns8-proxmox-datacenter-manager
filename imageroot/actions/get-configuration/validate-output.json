{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get Proxmox Datacenter Manager settings",
    "$id": "http://nethserver.org/json-schema/task/output/proxmox-datacenter-manager/get-configuration",
    "description": "Get Proxmox Datacenter Manager settings",
    "examples": [
        {
            "host": "pdm.domain.org",
            "http2https": true,
            "lets_encrypt": true,
            "admin_password_set": true,
            "options": {
                "tls_import": true,
                "disable_nag": true,
                "ns8_layout": true,
                "hide_menu": [
                    "subscription"
                ],
                "repo_test": false,
                "debian_extra": false
            }
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt",
        "admin_password_set",
        "options"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the application, like 'pdm.domain.org'",
            "format": "idn-hostname"
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate"
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection"
        },
        "admin_password_set": {
            "type": "boolean",
            "description": "True if an administrator password has been configured"
        },
        "options": {
            "type": "object",
            "title": "First configuration options",
            "description": "Chosen once at the first configuration; later requests keep the stored values.",
            "properties": {
                "tls_import": {
                    "type": "boolean",
                    "title": "Use the Traefik certificate",
                    "description": "Install the certificate Traefik serves for the host name in the Certificates page of Proxmox Datacenter Manager."
                },
                "disable_nag": {
                    "type": "boolean",
                    "title": "Confirm the subscription notice",
                    "description": "Confirm the 'no subscription' dialog automatically."
                },
                "ns8_layout": {
                    "type": "boolean",
                    "title": "NS8 layout",
                    "description": "Menu order Dashboard, Views, Notes, Remotes, Guests, Configuration; Shell and Administration in the top bar."
                },
                "hide_menu": {
                    "type": "array",
                    "title": "Hidden menu entries",
                    "items": {
                        "type": "string",
                        "enum": [
                            "subscription",
                            "registry",
                            "sdn",
                            "ceph"
                        ]
                    },
                    "uniqueItems": true
                },
                "repo_test": {
                    "type": "boolean",
                    "title": "Add the pdm-test repository (disabled)"
                },
                "debian_extra": {
                    "type": "boolean",
                    "title": "Add the Debian components contrib and non-free-firmware"
                }
            }
        }
    }
}
