import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "pypkg"))
import agent
import pdm_options

# Existing installations (before the Traefik certificate was imported) get it
# with the update. 20restart restarts the service afterwards.
host = os.environ.get("TRAEFIK_HOST", "")
options = pdm_options.read_options() or pdm_options.normalize(None)
if host and options["tls_import"]:
    os.makedirs("tls-certs", mode=0o700, exist_ok=True)
    proc = agent.run_helper("get-certificate", "--cert-file=tls-certs/cert.pem",
                            "--key-file=tls-certs/key.pem", host)
    if proc.returncode not in (0, 3):
        print("Could not obtain the Traefik certificate; PDM keeps its own.", file=sys.stderr)
