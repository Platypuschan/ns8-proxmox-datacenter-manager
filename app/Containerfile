# SPDX-License-Identifier: GPL-3.0-or-later
#
# Proxmox Datacenter Manager application image for the NS8 module.
#
# Built from Debian 13 with the packages of the official Proxmox repository
# (pdm-no-subscription). No mail server, no cron, no init system.

# Debian 13 slim, pinned by digest. The weekly update workflow proposes a newer
# digest (security fixes of the base layer) as a pull request.
ARG BASE_IMAGE=docker.io/library/debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
ARG PROXMOX_KEYRING_SHA256=136673be77aba35dcce385b28737689ad64fd785a797e57897589aed08db6e45

# --- build the rename shim (see ns8-rename-shim.c) ---------------------------
FROM ${BASE_IMAGE} AS shim
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev
COPY ns8-rename-shim.c /src/ns8-rename-shim.c
RUN gcc -O2 -Wall -fPIC -shared -o /ns8-rename-shim.so /src/ns8-rename-shim.c -ldl

# --- native PDM UI customization ----------------------------------------------
# Keep Yew in charge of its DOM: build the pinned upstream UI with a small
# source patch instead of reparenting live resource-tree/tab nodes in JavaScript.
FROM shim AS pdm-ui
ARG PDM_UI_COMMIT=aae6607b38f1b3701d88ceef25f14ce72bb258ca
ARG PDM_UI_VERSION=1.1.4
ARG PROXMOX_KEYRING_SHA256
ENV DEBIAN_FRONTEND=noninteractive
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl git patch dpkg-dev make; \
    curl -fsSL -o /usr/share/keyrings/proxmox-archive-keyring.gpg \
        https://enterprise.proxmox.com/debian/proxmox-archive-keyring-trixie.gpg; \
    echo "${PROXMOX_KEYRING_SHA256}  /usr/share/keyrings/proxmox-archive-keyring.gpg" | sha256sum -c -; \
    printf 'deb [signed-by=/usr/share/keyrings/proxmox-archive-keyring.gpg] http://download.proxmox.com/debian/devel trixie main\n' > /etc/apt/sources.list.d/proxmox-devel.list; \
    apt-get update; \
    git init /src; \
    git -C /src remote add origin https://git.proxmox.com/git/proxmox-datacenter-manager.git; \
    git -C /src fetch --depth 1 origin "$PDM_UI_COMMIT"; \
    git -C /src checkout --detach FETCH_HEAD; \
    test "$(git -C /src rev-parse HEAD)" = "$PDM_UI_COMMIT"; \
    test "$(dpkg-parsechangelog -l/src/ui/debian/changelog -SVersion)" = "$PDM_UI_VERSION"; \
    git -C /src -c url.https://git.proxmox.com/git/.insteadOf=git://git.proxmox.com/git/ submodule update --init; \
    apt-get install -y --no-install-recommends \
        librust-proxmox-installer-types-dev=0.2.1-1 \
        librust-pwt-dev=0.8.22 librust-proxmox-yew-comp-dev=0.8.26 \
        librust-proxmox-subscription-dev librust-proxmox-node-status-dev iso-codes; \
    apt-get build-dep -y --no-install-recommends /src/ui
COPY pdm-ui.patch /src/ns8-pdm-ui.patch
RUN set -eux; \
    cd /src; \
    patch --batch --fuzz=0 -p1 < ns8-pdm-ui.patch; \
    make -C ui -j2; \
    dpkg-query -W > ns8-build-packages.txt; \
    printf '%s\n' "$PDM_UI_COMMIT" > ns8-upstream-commit; \
    tar --exclude=.git --exclude=target --exclude=dist -czf /ns8-pdm-ui-source.tar.gz .

# --- the application image ----------------------------------------------------
FROM ${BASE_IMAGE}

# Raise these two values to update PDM; the CI image tag follows the content of
# this directory, so a change publishes a new image and never replaces one.
ARG PDM_VERSION=1.1.9
ARG PDM_UI_VERSION=1.1.4
# sha256 of https://enterprise.proxmox.com/debian/proxmox-archive-keyring-trixie.gpg
# A key rotation by Proxmox makes the build fail on purpose.
ARG PROXMOX_KEYRING_SHA256

LABEL org.opencontainers.image.title="Proxmox Datacenter Manager (NS8 module runtime)" \
      org.opencontainers.image.source="https://github.com/Platypuschan/ns8-proxmox-datacenter-manager" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.description="Unofficial container for Proxmox Datacenter Manager; not supported by Proxmox."

ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    curl -fsSL -o /usr/share/keyrings/proxmox-archive-keyring.gpg \
        https://enterprise.proxmox.com/debian/proxmox-archive-keyring-trixie.gpg; \
    echo "${PROXMOX_KEYRING_SHA256}  /usr/share/keyrings/proxmox-archive-keyring.gpg" | sha256sum -c -; \
    printf 'Types: deb\nURIs: http://download.proxmox.com/debian/pdm\nSuites: trixie\nComponents: pdm-no-subscription\nSigned-By: /usr/share/keyrings/proxmox-archive-keyring.gpg\n' \
        > /etc/apt/sources.list.d/pdm.sources; \
    apt-get update; \
    # The maintainer scripts call systemctl and try to start the services; both
    # are meaningless while building. Remove the stubs again afterwards.
    printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/systemctl; chmod +x /usr/local/bin/systemctl; \
    printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d; chmod +x /usr/sbin/policy-rc.d; \
    # No kernel, firmware or init system in a container. These pins also keep
    # the "Upgrade" button of the web interface from pulling them in.
    printf 'Package: proxmox-default-kernel proxmox-kernel-* pve-firmware proxmox-kernel-helper systemd-sysv linux-image-*\nPin: release *\nPin-Priority: -1\n' \
        > /etc/apt/preferences.d/99-ns8-container; \
    apt-get install -y --no-install-recommends \
        "proxmox-datacenter-manager=${PDM_VERSION}" \
        "proxmox-datacenter-manager-ui=${PDM_UI_VERSION}" proxmox-datacenter-manager-client \
        ifupdown2 proxmox-mail-forward proxmox-offline-mirror-helper zfsutils-linux \
        openssl tini; \
    # Placeholder for proxmox-datacenter-manager-meta: the real package depends
    # on a kernel and systemd-sysv. The web interface lists it in "Package
    # Versions" and reports "not correctly installed" without it.
    mkdir -p /tmp/meta/DEBIAN; \
    printf 'Package: proxmox-datacenter-manager-meta\nVersion: %s\nSection: admin\nPriority: optional\nArchitecture: all\nMaintainer: ns8-proxmox-datacenter-manager <noreply@users.noreply.github.com>\nDepends: proxmox-archive-keyring, proxmox-datacenter-manager, proxmox-datacenter-manager-client, proxmox-datacenter-manager-docs, proxmox-datacenter-manager-ui\nDescription: Container variant of proxmox-datacenter-manager-meta\n The original package also depends on a kernel and an init system, which do\n not belong in a container. This empty package only depends on the Proxmox\n Datacenter Manager packages.\n' "${PDM_VERSION}" > /tmp/meta/DEBIAN/control; \
    dpkg-deb --build /tmp/meta /tmp/meta.deb; \
    dpkg -i /tmp/meta.deb; \
    rm -rf /tmp/meta /tmp/meta.deb; \
    # PDM is updated with the module image, not inside the container.
    apt-mark hold proxmox-datacenter-manager proxmox-datacenter-manager-ui proxmox-datacenter-manager-docs proxmox-datacenter-manager-client proxmox-datacenter-manager-meta; \
    # Package upgrades started from the web interface run without a terminal and
    # without DEBIAN_FRONTEND: use the non-interactive debconf frontend and keep
    # existing configuration files.
    echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections; \
    printf 'Dpkg::Options { "--force-confdef"; "--force-confold"; };\n' > /etc/apt/apt.conf.d/90-ns8-noninteractive; \
    rm -f /usr/local/bin/systemctl /usr/sbin/policy-rc.d; \
    # curl stays: it is a dependency of proxmox-datacenter-manager.
    rm -f /etc/apt/sources.list.d/pdm-enterprise.* /etc/apt/sources.list.d/ceph.*; \
    # Fail the build if a maintainer script did not complete.
    for p in proxmox-datacenter-manager proxmox-datacenter-manager-meta ifupdown2 proxmox-mail-forward proxmox-offline-mirror-helper zfsutils-linux; do \
        test "$(dpkg-query -W -f='${db:Status-Status}' "$p")" = installed; \
    done; \
    test -x /usr/libexec/proxmox/proxmox-datacenter-api; \
    test -x /usr/libexec/proxmox/proxmox-datacenter-privileged-api; \
    dpkg-query -W -f='${Version}\n' proxmox-datacenter-manager > /etc/pdm-version; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/*

COPY --from=shim /ns8-rename-shim.so /usr/lib/ns8-rename-shim.so
COPY --from=pdm-ui /src/ui/dist/pdm-ui_bundle.js /src/ui/dist/pdm-ui_bg.wasm.gz /usr/share/javascript/proxmox-datacenter-manager/js/
COPY --from=pdm-ui /src/ui/dist/crisp-yew-style.css /src/ui/dist/material-yew-style.css /src/ui/dist/desktop-yew-style.css /usr/share/javascript/proxmox-datacenter-manager/
COPY --from=pdm-ui /ns8-pdm-ui-source.tar.gz /usr/share/javascript/proxmox-datacenter-manager/js/ns8-pdm-ui-source.tar.gz

# Interface adjustments (menu, top bar, subscription notice); see ns8-custom.js
RUN set -eux; \
    www=/usr/share/javascript/proxmox-datacenter-manager; \
    grep -q '</body>' "$www/index.hbs"; \
    sed -i 's#</body>#   <script src="/js/ns8-config.js"></script>\n   <script src="/js/ns8-custom.js" defer></script>\n   </body>#' "$www/index.hbs"; \
    grep -q ns8-custom.js "$www/index.hbs"
COPY ns8-custom.js /usr/share/javascript/proxmox-datacenter-manager/js/ns8-custom.js

COPY --chmod=755 entrypoint.sh /usr/local/bin/entrypoint.sh

EXPOSE 8443
VOLUME /etc/proxmox-datacenter-manager /var/lib/proxmox-datacenter-manager /var/log/proxmox-datacenter-manager

ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/local/bin/entrypoint.sh"]
